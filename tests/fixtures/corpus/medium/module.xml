    <ProgramUnit Name="P_HELPER" ProgramUnitType="Function" ProgramUnitText="FUNCTION P_HELPER RETURN NUMBER IS&amp;#10;  v_n NUMBER;&amp;#10;BEGIN&amp;#10;  SELECT COUNT(*) INTO v_n FROM TBL_01;&amp;#10;  RETURN v_n;&amp;#10;END;" />
    <RecordGroup Name="RG_STATUS" RecordGroupType="Query" RecordGroupQuery="SELECT LABEL, CODE FROM STATUS_LOOKUP" />
    <LOV Name="LOV_STATUS" RecordGroupName="RG_STATUS" Title="Status">
