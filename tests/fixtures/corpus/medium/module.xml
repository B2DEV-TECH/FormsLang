<?xml version='1.0' encoding='UTF-8'?>
<Module xmlns="http://xmlns.oracle.com/Forms" version="12.2.1.4.0">
  <FormModule Name="MEDIUM_FORM" Title="Medium Fixture" FirstNavigationBlockName="B_01">
