-- Case C: ORDER_API body owned by BILLING_OWNER. Synthetic fixture.
CREATE OR REPLACE PACKAGE BODY BILLING_OWNER.ORDER_API AS
  PROCEDURE SUBMIT(p_order_id NUMBER) IS
  BEGIN
    UPDATE BILLING_OWNER.BILLING_ORDERS SET STATUS = 'SUBMITTED' WHERE ORDER_ID = p_order_id;
  END SUBMIT;
END ORDER_API;
/
